<?xml version="1.0"?>
<robot name="box_50x50x50">
  <!-- Dimensions are in metres. Uniform 50 g mass is a provisional value. -->
  <link name="box">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002083333333333333" ixy="0" ixz="0"
               iyy="0.00002083333333333333" iyz="0" izz="0.00002083333333333333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="box_gold">
        <color rgba="0.85 0.65 0.20 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
  </link>
</robot>
